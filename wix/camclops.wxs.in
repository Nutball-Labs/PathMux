<?xml version="1.0" encoding="UTF-8"?>
<!--
  CamClops Windows MSI package definition — WiX 6
  Do NOT use WiX 3 (candle/light) with this file; it uses the v4/v6 schema.

  CMake configure_file(@ONLY) substitutes @VER_*@ tokens at configure time.
  BinDir and SrcDir are passed at build time:
      wix build -d BinDir=<build-win dir> -d SrcDir=<source root>

  windeployqt must be run on camclops-gui.exe before this target so that Qt
  DLLs and plugin subdirectories exist in BinDir.  run-build.ps1 handles
  this automatically; the CMake install(CODE ...) step handles it for CPack.

  UPGRADE GUID: A7F93C1E-2B47-4D8F-9A12-6BE89B540D75
  This GUID must never change — it ties all CamClops MSI versions together
  so Windows Installer can detect and upgrade previous installations.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Package
      Name="CamClops @VER_MAJOR@.@VER_MINOR@.@VER_PATCH@"
      Version="@VER_MAJOR@.@VER_MINOR@.@VER_PATCH@.@VER_BUILD@"
      Manufacturer="Nutball Labs"
      UpgradeCode="A7F93C1E-2B47-4D8F-9A12-6BE89B540D75"
      Scope="perMachine">

    <SummaryInformation
        Description="CamClops Dashcam Explorer — multi-camera footage manager"
        Manufacturer="Nutball Labs" />

    <!-- Remove older versions on upgrade; block downgrades. -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of CamClops is already installed." />

    <!-- Single embedded cabinet — no loose files alongside the MSI. -->
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLDIR" Name="CamClops">

        <!-- Python overlay scripts subdirectory -->
        <Directory Id="dir_scripts"             Name="scripts" />

        <!-- Qt plugin subdirectories — must exist before ComponentGroups reference them -->
        <Directory Id="dir_platforms"           Name="platforms" />
        <Directory Id="dir_styles"              Name="styles" />
        <Directory Id="dir_imageformats"        Name="imageformats" />
        <Directory Id="dir_iconengines"         Name="iconengines" />
        <Directory Id="dir_generic"             Name="generic" />
        <Directory Id="dir_networkinformation"  Name="networkinformation" />
        <Directory Id="dir_tls"                 Name="tls" />

        <!-- Documentation from source tree -->
        <Component Id="C_LICENSE" Guid="*">
          <File Source="$(var.SrcDir)\LICENSE" KeyPath="yes" />
        </Component>
        <Component Id="C_README" Guid="*">
          <File Source="$(var.SrcDir)\README.md" KeyPath="yes" />
        </Component>

        <!-- Add install dir to system PATH so all clops_* tools are reachable from any prompt -->
        <Component Id="C_PATH" Guid="*">
          <RegistryValue Root="HKLM" Key="Software\NutballLabs\CamClops" Name="installed" Type="integer" Value="1" KeyPath="yes" />
          <Environment Id="PATH" Name="PATH" Value="[INSTALLDIR]" Permanent="no" Part="last" Action="set" System="yes" />
        </Component>

      </Directory>
    </StandardDirectory>

    <Feature Id="Complete" Title="CamClops" Level="1">
      <!-- Harvested file groups (defined in Fragment below) -->
      <ComponentGroupRef Id="grp_root" />
      <ComponentGroupRef Id="grp_platforms" />
      <ComponentGroupRef Id="grp_styles" />
      <ComponentGroupRef Id="grp_imageformats" />
      <ComponentGroupRef Id="grp_iconengines" />
      <ComponentGroupRef Id="grp_generic" />
      <ComponentGroupRef Id="grp_networkinformation" />
      <ComponentGroupRef Id="grp_tls" />
      <!-- Explicit components -->
      <ComponentRef Id="C_LICENSE" />
      <ComponentRef Id="C_README" />
      <ComponentRef Id="C_PATH" />
      <ComponentGroupRef Id="grp_scripts" />
    </Feature>

  </Package>

  <!--
    Fragment: ComponentGroups that harvest BinDir content.
    Using Fragment + ComponentGroup with Directory= attribute is the correct
    WiX 6 pattern for harvesting multiple files into named referenceable groups.
    windeployqt must have been run before wix build so these globs resolve.
  -->
  <Fragment>
    <!-- Python overlay scripts — must live in scripts\ relative to the exe.
         Source these from SrcDir, not BinDir; they are source files, not build
         artifacts, and are never copied into the build directory. Use clops_*.py
         to exclude build-time tools (gen_logo_morph.py, etc.). -->
    <ComponentGroup Id="grp_scripts" Directory="dir_scripts">
      <Files Include="$(var.SrcDir)\scripts\clops_*.py" />
    </ComponentGroup>

    <!-- Root: all EXEs + all DLLs (Qt, MinGW runtime, libcamclops, support DLLs) -->
    <ComponentGroup Id="grp_root" Directory="INSTALLDIR">
      <Files Include="$(var.BinDir)\*.exe" />
      <Files Include="$(var.BinDir)\*.dll" />
    </ComponentGroup>

    <!-- Qt platform plugin — must live in platforms\ relative to the exe -->
    <ComponentGroup Id="grp_platforms" Directory="dir_platforms">
      <Files Include="$(var.BinDir)\platforms\*.dll" />
    </ComponentGroup>

    <!-- Qt style plugin -->
    <ComponentGroup Id="grp_styles" Directory="dir_styles">
      <Files Include="$(var.BinDir)\styles\*.dll" />
    </ComponentGroup>

    <!-- Qt image format plugins -->
    <ComponentGroup Id="grp_imageformats" Directory="dir_imageformats">
      <Files Include="$(var.BinDir)\imageformats\*.dll" />
    </ComponentGroup>

    <!-- Qt icon engine plugins -->
    <ComponentGroup Id="grp_iconengines" Directory="dir_iconengines">
      <Files Include="$(var.BinDir)\iconengines\*.dll" />
    </ComponentGroup>

    <!-- Qt generic input plugins -->
    <ComponentGroup Id="grp_generic" Directory="dir_generic">
      <Files Include="$(var.BinDir)\generic\*.dll" />
    </ComponentGroup>

    <!-- Qt network information plugins -->
    <ComponentGroup Id="grp_networkinformation" Directory="dir_networkinformation">
      <Files Include="$(var.BinDir)\networkinformation\*.dll" />
    </ComponentGroup>

    <!-- Qt TLS backend plugins -->
    <ComponentGroup Id="grp_tls" Directory="dir_tls">
      <Files Include="$(var.BinDir)\tls\*.dll" />
    </ComponentGroup>
  </Fragment>

</Wix>
<!-- SN: 00106 -->
