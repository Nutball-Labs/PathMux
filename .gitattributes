# Line-ending normalization: store LF in git, check out LF on all platforms.
# This eliminates the CRLF/LF round-trip conflicts that occur when mixing
# Windows (core.autocrlf=true) and macOS/Linux (core.autocrlf=false) machines.
# All text editors in use (VS Code, vim) handle LF cleanly on Windows.
* text=auto eol=lf

# Explicit binary markers so git never tries to convert these
*.png    binary
*.jpg    binary
*.ico    binary
*.icns   binary
*.pkg    binary
*.zip    binary
*.tgz    binary
*.msi    binary
*.exe    binary
*.dll    binary
*.a      binary
*.dylib  binary
*.so     binary
